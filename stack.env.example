# Journey Planner - Portainer Stack Environment Variables
# Copy this file to stack.env and fill with your production values
# These variables will override .env when loaded by Docker

# ===========================================
# APPLICATION URLS (PRODUCTION)
# ===========================================
#
# FRONTEND_URL=http://100.103.184.90:5173
# VITE_API_URL=http://100.103.184.90:5001/api
# CORS_ORIGIN=http://100.103.184.90:5173

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# UWAGA: Upewnij się, że baza journey_planner istnieje i zawiera admin usera!
# Komenda SQL do wykonania (jeśli jeszcze nie zrobione):
#   psql -h 192.168.1.218 -U postgres -c "CREATE DATABASE journey_planner;"
#   psql -h 192.168.1.218 -U journey_user -d journey_planner -f database/init.sql
DB_HOST=192.168.1.218
DB_PORT=5432
DB_NAME=journey_planner
DB_USER=journey_user
DB_PASSWORD=StrongPassword123!

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=JWTSuperSecretKeyChangeMe!
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# JWT_SECRET - klucz do podpisywania tokenów JWT
# Możesz wygenerować silny klucz JWT za pomocą polecenia:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Wklej wygenerowany ciąg jako wartość JWT_SECRET

# JWT_REFRESH_SECRET - klucz do podpisywania refresh tokenów JWT
# Zalecane: inny niż JWT_SECRET
# Wygeneruj analogicznie:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Wklej wygenerowany ciąg jako wartość JWT_REFRESH_SECRET

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=journey.alertmail@gmail.com
SMTP_PASSWORD=YourAppPasswordHere
SMTP_FROM_EMAIL=journey.alertmail@gmail.com
SMTP_FROM_NAME=Journey Planner

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=production
BACKEND_PORT=5001
FRONTEND_PORT=5173

# ===========================================
# FILE UPLOAD
# ===========================================
UPLOAD_DIR=/app/uploads/attachments
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,image/jpg,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
FILE_ENCRYPTION_KEY=

# ===========================================
# DOCKER IMAGE
# ===========================================
IMAGE_TAG=latest
